# Teacher Bot YT - Git ignore

# Environment
.env

# Credentials
# We want to track tokens so they don't disappear on push
!token.json
!client_secrets.json

# Ignore generic json files but explicitly keep curriculum and progress
*.json
!curriculum.json
!topics_index.json
!data/topics_index.json
!data/topics_progress.json
!data/curriculum.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Temp files
temp_frames/
temp_audio/
temp_*.html
data/extracted_images/

# Output
outputs/
*.mp4
*.mp3

# Progress (optional - uncomment if you don't want to track progress in git)
# data/
# topics_progress.json
# topics_index.json

# OS
.DS_Store
Thumbs.db