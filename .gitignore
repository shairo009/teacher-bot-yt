# Teacher Bot YT - Git ignore

# Environment & credentials
.env
*.pem
client_secrets.json
token.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/

# Generated during each run (rebuilt from curriculum.json)
data/topics_index.json
data/extracted_images/

# Temp files (created during video generation, cleaned up after)
temp_frames/
temp_audio/
temp_*.html

# Output videos (uploaded to YouTube, not needed in git)
outputs/
*.mp4
*.mp3
*.wav

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
